[importlinter]
root_packages =
    app
include_external_packages = True

[importlinter:contract:app-layers]
name = App layers: routes above services above the engine
type = layers
layers =
    app.main
    app.routes
    app.navigator | app.models
    app.engine | app.environment | app.prompts

[importlinter:contract:engine-layers]
name = Engine layers: diagrams and engine above model above logic
type = layers
containers =
    app.engine
layers =
    diagrams | engine
    model
    logic

[importlinter:contract:engine-deterministic]
name = The rules engine stays deterministic: no web framework or LLM clients
type = forbidden
source_modules =
    app.engine
forbidden_modules =
    fastapi
    anthropic
    typesafe_sdk
    app.models
    app.environment
